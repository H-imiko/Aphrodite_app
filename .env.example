# Configuration locale. Copier ce fichier en `.env` puis adapter.
# `.env` n'est jamais versionne (voir .gitignore).
#
# Regle : une variable definie dans l'environnement du systeme a priorite
# sur ce fichier.

# --- Developpement -----------------------------------------------------------
# 1 en local, 0 sur le serveur (0 rend DEBUG, HTTPS et cookies surs actifs).
DJANGO_DEBUG=1

# --- Cle secrete -------------------------------------------------------------
# Obligatoire des que DJANGO_DEBUG=0.
# Generer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# --- Hotes et formulaires ----------------------------------------------------
# Obligatoire des que DJANGO_DEBUG=0. Liste separee par des virgules.
# DJANGO_ALLOWED_HOSTS=aphrodite.example.com,www.aphrodite.example.com
# Le domaine doit aussi etre ici pour que les formulaires passent le CSRF.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://aphrodite.example.com,https://www.aphrodite.example.com
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Derriere un reverse proxy de confiance (nginx, Caddy, IIS+ARR), passer a 1
# pour que la limitation de debit compte la vraie adresse cliente. Laisser a 0
# sans proxy : sinon l'entete X-Forwarded-For, falsifiable, permet de
# contourner la limitation.
DJANGO_USE_X_FORWARDED_FOR=0

# --- Base de donnees ---------------------------------------------------------
# Laisser vide (ou sqlite) pour le fichier db.sqlite3 local.
# DJANGO_DB_ENGINE=postgres
# POSTGRES_DB=aphrodite
# POSTGRES_USER=aphrodite
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# --- Tresor et bonus ---------------------------------------------------------
# Plafond d'un envoi du Tresor par une Gardienne (Safir: illimite).
# DJANGO_LIMITE_ENVOI_GARDIENNE=5000
# Plafond quotidien total d'une Gardienne.
# DJANGO_PLAFOND_JOURNALIER_TRESOR=50000
# Bonus quotidiens servis a un meme appareil (IP + navigateur).
# DJANGO_BONUS_PLAFOND_APPAREIL=3

# --- Sauvegardes -------------------------------------------------------------
# Dossier des copies de la base (defaut : ./sauvegardes).
# DJANGO_SAUVEGARDES_DIR=/var/sauvegardes/aphrodite

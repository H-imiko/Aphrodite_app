msgstr "Demasiadas solicitudes desde esta red. Inténtalo más tarde."

msgid "Trop de tentatives d'inscription depuis ce réseau. Réessaie dans un quart d'heure."
msgstr "Demasiados intentos de registro desde esta red. Inténtalo de nuevo en quince minutos."

msgid "Trop de tentatives de connexion. Patiente quelques minutes avant de réessayer."
msgstr "Demasiados intentos de inicio de sesión. Espera unos minutos antes de volver a intentarlo."

msgid "Tu as encore <strong>%(n)s commande en cours</strong>."
msgid_plural "Tu as encore <strong>%(n)s commandes en cours</strong>."
msgstr[0] "Todavía tienes <strong>%(n)s pedido en curso</strong>."
msgstr[1] "Todavía tienes <strong>%(n)s pedidos en curso</strong>."

msgid "Tu as toujours accès à ton email ?"
msgstr "¿Sigues teniendo acceso a tu correo?"

msgid "Tu te souviens de ton mot de passe ?"
msgstr "¿Te acuerdas de tu contraseña?"

msgid "Tu utilises un mot de passe provisoire remis par l'équipe. Choisis-en un nouveau dès maintenant."
msgstr "Estás usando una contraseña provisional entregada por el equipo. Elige una nueva ahora mismo."


msgid "Tant qu'une commande n'est pas terminée ou annulée, elle garde des Cubis bloqués (séquestre) ou une décision en attente : fermer ton compte maintenant laisserait l'acheteur sans recours et ses Cubis bloqués définitivement."
msgstr "Mientras un pedido no esté terminado o cancelado, mantiene Cubis bloqueados (en depósito) o una decisión pendiente: cerrar tu cuenta ahora dejaría al comprador sin recurso y sus Cubis bloqueados para siempre."

msgid "Termine la livraison, confirme la réception ou annule la commande, puis reviens sur cette page : la suppression sera alors possible."
msgstr "Termina la entrega, confirma la recepción o cancela el pedido, y vuelve a esta página: entonces será posible la eliminación."

msgid "Tes créations"
msgstr "Tus creaciones"

msgid "Ton adresse email"
msgstr "Tu correo electrónico"

msgid "Ton compte est supprimé. Merci d'avoir joué."
msgstr "Tu cuenta ha sido eliminada. Gracias por jugar."

msgid "Ton inventaire est vide. Visite la <a href=\"%(url_boutique)s\">boutique</a> !"
msgstr "Tu inventario está vacío. ¡Visita la <a href=\"%(url_boutique)s\">tienda</a>!"

msgid "Ton profil"
msgstr "Tu perfil"

